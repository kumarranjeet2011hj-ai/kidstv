<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>Kids TV - Watch</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            margin: 0;
            background: #f4f4f4;
        }

        header {
            background: #ff4d6d;
            color: white;
            padding: 20px;
            text-align: center;
            font-size: 30px;
            font-weight: bold;
        }

        .search-box {
            text-align: center;
            margin: 20px;
        }

        .search-box input {
            width: 60%;
            padding: 12px;
            font-size: 16px;
            border-radius: 25px;
            border: 1px solid #ccc;
        }

        .container {
            display: flex;
            flex-wrap: wrap;
            justify-content: center;
            padding: 20px;
        }

        .card {
            background: white;
            width: 200px;
            margin: 15px;
            border-radius: 15px;
            box-shadow: 0 4px 10px rgba(0,0,0,0.2);
            text-align: center;
            padding: 15px;
        }

        .card img {
            width: 100%;
            border-radius: 10px;
        }

        .card h3 {
            margin: 10px 0;
        }
    </style>
</head>
<body>

<header>
    Welcome to the Kids TV
</header>

<div class="search-box">
    <input type="text" id="search" placeholder="Search cartoons or animes..." onkeyup="searchShows()">
</div>

<div class="container" id="shows">

    <div class="card">
        <img src="https://via.placeholder.com/200x120" alt="">
        <h3>Doraemon</h3>
    </div>

    <div class="card">
        <img src="https://via.placeholder.com/200x120" alt="">
        <h3>Pokemon</h3>
    </div>

    <div class="card">
        <img src="https://via.placeholder.com/200x120" alt="">
        <h3>Naruto</h3>
    </div>

    <div class="card">
        <img src="https://via.placeholder.com/200x120" alt="">
        <h3>Shinchan</h3>
    </div>

    <div class="card">
        <img src="https://via.placeholder.com/200x120" alt="">
        <h3>Dragon Ball</h3>
    </div>

</div>

<script>
function searchShows() {
    let input = document.getElementById("search").value.toLowerCase();
    let cards = document.getElementsByClassName("card");

    for (let i = 0; i < cards.length; i++) {
        let title = cards[i].getElementsByTagName("h3")[0].innerText.toLowerCase();
        cards[i].style.display = title.includes(input) ? "block" : "none";
    }
}
</script>

</body>
</html>
